# Sample settings for the Playwright suite. Copy to tests/.env (git ignores it)
# or export them in your shell. Every value is optional; the defaults below
# assume an all-localhost stack. See README.md section 6.

# Browser. Anything other than "true" shows the browser (CI=true also hides it).
HEADLESS=false

# The stack under test.
TIDECLOAK_URL=http://localhost:8080
HOME_ORK_ORIGIN=http://localhost:1001
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=password

# The test-app the suite builds and starts. TEST_APP_PORT is the one knob: it
# sets the port the app listens on, the baseURL, and the client origins the
# realm recipes provision. Set it when something else already holds 3000.
# TEST_APP_PORT=3000
# BASE_URL overrides the lot, host included.
# BASE_URL=http://localhost:3000
# PW_SKIP_BUILD=1

# Sibling suites used for provisioning.
# IGA_ENGINE_DIR=~/tidecloak-iga-engine-tests
# TIDE_ADMIN_CLI_DIR=~/project/tidecloak-idp-extensions/tidecloak-key-provider/frontend/e2e

# Reusing a realm while debugging.
# RECIPE_REALM=
# TIDE_USER_PASSWORD=
# PW_REALM_CACHE_DIR=

# Spec 12 overrides.
# DPOP_USER=
# DPOP_PASSWORD=
# DPOP_CLIENT_A=
# DPOP_CLIENT_B=

# Where the CI scripts (ci/) look for sibling checkouts when you run them locally.
# TIDE_WORKSPACE=~/project
